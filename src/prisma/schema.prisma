// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum StatusType {
  a
  i
  b
}

enum GenderType {
  m
  f
  o
}

enum TeamsUsersStatusType {
  a
  c
  d
}

model Users {
  id                    Int         @id @default(autoincrement())
  name                  String
  nickname              String
  email                 String      @unique
  cpf                   String?     @unique @db.VarChar(11)
  cnpj                  String?     @unique @db.VarChar(14)
  type                  String?     @db.VarChar(2)
  rg                    String?     @unique @db.VarChar(9)
  rg_emitted_by         String?
  password              String      @db.Text
  gender                GenderType?
  birthdate             DateTime    @db.Date
  status                StatusType  @default(a)
  root                  Boolean?    @default(false)
  created               DateTime    @default(now())
  modified              DateTime    @default(now()) @updatedAt
  recovery_code         String?
  recovery_code_expires DateTime?
  change_password       Boolean?    @default(false)
  score                 Int         @default(0)

  group_users     GroupsUsers[]
  logs            Logs[]
  users_sessions  UsersSessions[]
  addresses       Address[]
  teams_users     TeamsUsers[]
  UsersCourses    UsersCourses[]
  UsersAdvertises UsersAdvertises[]
  UsersFunctions  UsersFunctions[]

  @@map("users")
}

model Groups {
  id       Int      @id @default(autoincrement())
  name     String
  show     Boolean  @default(true)
  created  DateTime @default(now())
  modified DateTime @updatedAt

  group_users       GroupsUsers[]
  group_permissions GroupsPermissions[]

  @@map("groups")
}

model GroupsUsers {
  id       Int    @id @default(autoincrement())
  group    Groups @relation(fields: [group_id], references: [id], onDelete: Cascade)
  group_id Int

  user    Users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id Int

  @@unique([group_id, user_id])
  @@map("groups_users")
}

model Modules {
  id       Int        @id @default(autoincrement())
  name     String
  status   StatusType @default(a)
  created  DateTime   @default(now())
  modified DateTime   @updatedAt

  permissions Permissions[]

  @@map("modules")
}

model Permissions {
  id        Int      @id @default(autoincrement())
  name      String
  root      Boolean  @default(false)
  component String
  action    String
  menu      Boolean  @default(false)
  created   DateTime @default(now())
  modified  DateTime @updatedAt

  module    Modules @relation(fields: [module_id], references: [id], onDelete: Cascade)
  module_id Int

  permission_groups GroupsPermissions[]

  @@map("permissions")
}

model GroupsPermissions {
  id       Int    @id @default(autoincrement())
  group    Groups @relation(fields: [group_id], references: [id], onDelete: Cascade)
  group_id Int

  permission    Permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade)
  permission_id Int

  @@unique([group_id, permission_id])
  @@map("groups_permissions")
}

model Images {
  id                 Int      @id @default(autoincrement())
  entity             String
  entity_id          Int
  original_file_name String
  src                String
  cover              Boolean  @default(false)
  created            DateTime @default(now())
  modified           DateTime @updatedAt

  events Events @relation(fields: [entity_id], references: [id], onDelete: Cascade)

  @@map("images")
}

model Files {
  id                 Int      @id @default(autoincrement())
  entity             String
  entity_id          Int
  original_file_name String
  src                String
  created            DateTime @default(now())
  modified           DateTime @updatedAt

  @@map("files")
}

model Variables {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  value       String
  created     DateTime @default(now())
  modified    DateTime @updatedAt

  @@map("variables")
}

model Logs {
  id           Int      @id @default(autoincrement())
  name         String
  title        String
  description  String
  reference    String
  reference_id String
  operation    String
  created      DateTime @default(now())

  user    Users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id Int

  @@map("logs")
}

model UsersSessions {
  id          Int       @id @default(autoincrement())
  user        Users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id     Int
  token       String    @db.Text
  ip          String
  created     DateTime  @default(now())
  expires     DateTime?
  last_access DateTime?

  @@map("users_sessions")
}

model Address {
  id           Int      @id @default(autoincrement())
  type         String?
  address      String?
  country      String?
  state        String?
  city         String?
  zip          String?
  neighborhood String?
  number       String?
  complement   String?
  entity       String
  entity_id    Int
  created      DateTime @default(now())
  modified     DateTime @default(now()) @updatedAt

  user Users @relation(fields: [entity_id], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model Advertisers {
  id    Int     @id @default(autoincrement())
  name  String
  url   String?
  about String? @db.Text

  places          Places[]
  UsersAdvertises UsersAdvertises[]
  Events          Events[]

  @@map("advertisers")
}

model UsersAdvertises {
  id            Int      @id @default(autoincrement())
  user_id       Int
  advertiser_id Int
  created       DateTime @default(now())
  modified      DateTime @default(now()) @updatedAt

  user       Users       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  advertiser Advertisers @relation(fields: [advertiser_id], references: [id], onDelete: Cascade)

  @@map("users_advertises")
}

model Places {
  id            Int      @id @default(autoincrement())
  advertiser_id Int?
  name          String
  description   String?
  address       String?
  number        String?
  neighborhood  String?
  city          String?
  state         String?
  country       String?
  zip           String?
  created       DateTime @default(now())
  modified      DateTime @default(now()) @updatedAt

  advertiser Advertisers? @relation(fields: [advertiser_id], references: [id], onDelete: Cascade)

  events Events[]

  @@map("places")
}

model Events {
  id            Int        @id @default(autoincrement())
  advertiser_id Int
  name          String
  date_start    DateTime
  date_end      DateTime?
  status        StatusType @default(a)
  place_id      Int
  created       DateTime   @default(now())
  modified      DateTime   @default(now()) @updatedAt

  place             Places              @relation(fields: [place_id], references: [id], onDelete: Cascade)
  advertiser        Advertisers         @relation(fields: [advertiser_id], references: [id], onDelete: Cascade)
  images            Images[]
  teams             Teams[]
  EventsOccurrences EventsOccurrences[]

  @@map("events")
}

model Sectors {
  id       Int        @id @default(autoincrement())
  name     String
  status   StatusType @default(a)
  created  DateTime   @default(now())
  modified DateTime   @default(now()) @updatedAt

  teams Teams[]

  @@map("sectors")
}

model TeamsStatus {
  id   Int    @id @default(autoincrement())
  name String

  teams Teams[]

  @@map("teams_status")
}

enum TaxTypes {
  period
  hour
}

model Functions {
  id       Int       @id @default(autoincrement())
  name     String
  created  DateTime  @default(now())
  modified DateTime  @default(now()) @updatedAt
  tax      Float?
  tax_type TaxTypes?

  teams_users      TeamsUsers[]
  FunctionsCourses FunctionsCourses[]
  UsersFunctions   UsersFunctions[]

  @@map("functions")
}

model Courses {
  id       Int      @id @default(autoincrement())
  name     String
  created  DateTime @default(now())
  modified DateTime @default(now()) @updatedAt

  functions    FunctionsCourses[]
  UsersCourses UsersCourses[]

  @@map("courses")
}

model FunctionsCourses {
  id          Int @id @default(autoincrement())
  function_id Int
  course_id   Int

  function Functions @relation(fields: [function_id], references: [id], onDelete: Cascade)
  course   Courses   @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@unique([function_id, course_id])
  @@map("functions_courses")
}

model UsersCourses {
  int         Int      @id @default(autoincrement())
  user_id     Int
  course_id   Int
  valid_until DateTime
  certified   Boolean  @default(false)

  user   Users   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  course Courses @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@map("users_courses")
}

model Teams {
  id             Int        @id @default(autoincrement())
  event_id       Int
  sector_id      Int?
  team_status_id Int
  name           String
  status         StatusType @default(a)
  extra_amount   Float?
  quantity       Int
  date_start     DateTime
  date_end       DateTime?
  created        DateTime   @default(now())
  modified       DateTime   @default(now()) @updatedAt

  teamStatus TeamsStatus  @relation(fields: [team_status_id], references: [id], onDelete: Restrict)
  sector     Sectors?     @relation(fields: [sector_id], references: [id], onDelete: Restrict)
  teamsUsers TeamsUsers[]
  event      Events       @relation(fields: [event_id], references: [id], onDelete: Cascade)

  @@map("teams")
}

model TeamsUsersStatus {
  id   Int    @id @default(autoincrement())
  name String

  teamsUsers TeamsUsers[]

  @@map("teams_users_status")
}

model TeamsUsers {
  id                    Int                  @id @default(autoincrement())
  teams_id              Int
  user_id               Int?
  function_id           Int
  date_start            DateTime
  date_end              DateTime?
  confirmed             TeamsUsersStatusType @default(a)
  justification         String?
  identification        String?
  created               DateTime             @default(now())
  modified              DateTime             @default(now()) @updatedAt
  minutes_worked        Int?
  worked_amount         Float?
  extra_amount          Float?
  total_amount          Float?
  teams_users_status_id Int

  user              Users?              @relation(fields: [user_id], references: [id], onDelete: Cascade)
  team              Teams               @relation(fields: [teams_id], references: [id], onDelete: Cascade)
  function          Functions           @relation(fields: [function_id], references: [id], onDelete: Cascade)
  TeamsUsersStatus  TeamsUsersStatus?   @relation(fields: [teams_users_status_id], references: [id], onDelete: Restrict)
  EventsOccurrences EventsOccurrences[]

  @@unique([teams_id, user_id])
  @@map("teams_users")
}

model UsersFunctions {
  id          Int       @id @default(autoincrement())
  user_id     Int
  function_id Int
  default     Boolean?  @default(false)
  user        Users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  function    Functions @relation(fields: [function_id], references: [id], onDelete: Cascade)

  @@unique([user_id, function_id])
  @@unique([user_id, function_id, default])
  @@map("users_functions")
}

model Occurrences {
  id                Int                 @id @default(autoincrement())
  name              String
  description       String?
  created           DateTime            @default(now())
  modified          DateTime            @default(now()) @updatedAt
  EventsOccurrences EventsOccurrences[]

  @@map("occurrences")
}

model EventsOccurrences {
  id            Int      @id @default(autoincrement())
  event_id      Int
  user_id       Int
  team_user_id  Int
  occurrence_id Int
  observation   String?
  created       DateTime @default(now())
  modified      DateTime @default(now()) @updatedAt

  event      Events      @relation(fields: [event_id], references: [id], onDelete: Cascade)
  occurrence Occurrences @relation(fields: [occurrence_id], references: [id], onDelete: Cascade)
  teamUser   TeamsUsers  @relation(fields: [team_user_id], references: [id], onDelete: Cascade)

  @@map("events_occurrences")
}
