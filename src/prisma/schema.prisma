// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum StatusType {
  a
  i
  b
}

enum GenderType {
  m
  f
  o
}

model Users {
  id                    Int         @id @default(autoincrement())
  name                  String
  nickname              String
  email                 String      @unique
  cpf                   String?     @unique @db.VarChar(11)
  cnpj                  String?     @unique @db.VarChar(14)
  type                  String?     @db.VarChar(2)
  rg                    String?     @unique @db.VarChar(9)
  rg_emitted_by         String?
  password              String      @db.Text
  gender                GenderType?
  birthdate             DateTime    @db.Date
  status                StatusType  @default(a)
  root                  Boolean?    @default(false)
  created               DateTime    @default(now())
  modified              DateTime    @default(now()) @updatedAt
  recovery_code         String?
  recovery_code_expires DateTime?
  change_password       Boolean?    @default(false)

  group_users    GroupsUsers[]
  logs           Logs[]
  users_sessions UsersSessions[]
  addresses      Address[]

  @@map("users")
}

model Groups {
  id       Int      @id @default(autoincrement())
  name     String
  show     Boolean  @default(true)
  created  DateTime @default(now())
  modified DateTime @updatedAt

  group_users       GroupsUsers[]
  group_permissions GroupsPermissions[]

  @@map("groups")
}

model GroupsUsers {
  id       Int    @id @default(autoincrement())
  group    Groups @relation(fields: [group_id], references: [id], onDelete: Cascade)
  group_id Int

  user    Users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id Int

  @@unique([group_id, user_id])
  @@map("groups_users")
}

model Modules {
  id       Int        @id @default(autoincrement())
  name     String
  status   StatusType @default(a)
  created  DateTime   @default(now())
  modified DateTime   @updatedAt

  permissions Permissions[]

  @@map("modules")
}

model Permissions {
  id        Int      @id @default(autoincrement())
  name      String
  root      Boolean  @default(false)
  component String
  action    String
  menu      Boolean  @default(false)
  created   DateTime @default(now())
  modified  DateTime @updatedAt

  module    Modules @relation(fields: [module_id], references: [id], onDelete: Cascade)
  module_id Int

  permission_groups GroupsPermissions[]

  @@map("permissions")
}

model GroupsPermissions {
  id       Int    @id @default(autoincrement())
  group    Groups @relation(fields: [group_id], references: [id], onDelete: Cascade)
  group_id Int

  permission    Permissions @relation(fields: [permission_id], references: [id], onDelete: Cascade)
  permission_id Int

  @@unique([group_id, permission_id])
  @@map("groups_permissions")
}

model Images {
  id                 Int      @id @default(autoincrement())
  entity             String
  entity_id          Int
  original_file_name String
  src                String
  cover              Boolean  @default(false)
  created            DateTime @default(now())
  modified           DateTime @updatedAt

  @@map("images")
}

model Files {
  id                 Int      @id @default(autoincrement())
  entity             String
  entity_id          Int
  original_file_name String
  src                String
  created            DateTime @default(now())
  modified           DateTime @updatedAt

  @@map("files")
}

model Variables {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  value       String
  created     DateTime @default(now())
  modified    DateTime @updatedAt

  @@map("variables")
}

model Logs {
  id           Int      @id @default(autoincrement())
  name         String
  title        String
  description  String
  reference    String
  reference_id String
  operation    String
  created      DateTime @default(now())

  user    Users @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id Int

  @@map("logs")
}

model UsersSessions {
  id          Int       @id @default(autoincrement())
  user        Users     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id     Int
  token       String    @db.Text
  ip          String
  created     DateTime  @default(now())
  expires     DateTime?
  last_access DateTime?

  @@map("users_sessions")
}

model Address {
  id           Int      @id @default(autoincrement())
  type         String?
  address      String?
  country      String?
  state        String?
  city         String?
  zip          String?
  neighborhood String?
  number       String?
  complement   String?
  entity       String
  entity_id    Int
  created      DateTime @default(now())
  modified     DateTime @default(now()) @updatedAt

  user Users @relation(fields: [entity_id], references: [id], onDelete: Cascade)

  @@map("addresses")
}
